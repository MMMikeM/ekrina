---
import raw from "../data/pareto.json";
import {
	captionOf,
	chartSvg,
	constructorNote,
	CORPORA,
	CORPUS_LABELS,
	corpusOf,
	MEASURE_LABELS,
	MEASURES,
	SCALE_LABELS,
	SCALES,
	noteTexts,
	type Measure,
	type ParetoData,
	type ParetoState,
	pointsOf,
	sizeLabel,
	sizeNote,
	tableHtml,
	viewFrontier,
} from "../pareto.ts";

interface Props {
	measure: Measure;
}

const data = raw as ParetoData;
const { measure } = Astro.props;
const state: ParetoState = {
	measure,
	constructorCounted: true,
	corpus: "native",
	size: "10000",
	scale: "log",
};
const id = `pareto-${measure}`;
const note = constructorNote(state);
const notes = noteTexts(data);
const sizes = [...new Set(data.corpora.filter((corpus) => corpus.ranked).flatMap((corpus) => corpus.sizes))];
const front = viewFrontier(data, state, pointsOf(data, state));
const frontier = front.length > 1 ? "line" : front.length === 1 ? "point" : "none";
// Without script the chart cannot lay out to its column, so both widths ship and CSS shows one.
const WIDE_PX = 640;
const NARROW_PX = 340;
---

<figure class="pareto" data-pareto={JSON.stringify(state)} data-frontier={frontier}>
	<form class="pareto-controls decoration not-content" aria-label="What the chart plots" hidden>
		<fieldset>
			<legend>Measure</legend>
			<div class="segmented">
				{
					MEASURES.map((option) => (
						<label>
							<input type="radio" name={`${id}-measure`} value={option} checked={option === measure} />
							<span>{MEASURE_LABELS[option]}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<fieldset aria-describedby={`${id}-constructor-note`}>
			<legend>Constructor</legend>
			<p class="control-hint" id={`${id}-constructor-note`}>
				{notes.constructor.map((text) => <span data-active={text === note || undefined}>{text}</span>)}
			</p>
			<div class="segmented">
				{
					[
						{ value: "counted", label: "Counted" },
						{ value: "not-counted", label: "Not counted" },
					].map((option) => (
						<label>
							<input
								type="radio"
								name={`${id}-constructor`}
								value={option.value}
								checked={!note && option.value === "counted"}
								disabled={Boolean(note)}
							/>
							<span>{option.label}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<fieldset class="corpus-control" aria-describedby={`${id}-corpus-note`}>
			<legend>Corpus</legend>
			<div class="segmented">
				{
					CORPORA.map((corpus) => (
						<label>
							<input type="radio" name={`${id}-corpus`} value={corpus} checked={corpus === state.corpus} />
							<span>{CORPUS_LABELS[corpus]}</span>
						</label>
					))
				}
			</div>
			<p class="corpus-definition" id={`${id}-corpus-note`}>
				{
					notes.corpus.map((text, i) => (
						<span data-active={CORPORA[i] === state.corpus || undefined}>{text}</span>
					))
				}
			</p>
		</fieldset>
		<fieldset class="size-control" aria-describedby={`${id}-size-note`}>
			<legend>Size</legend>
			<p class="control-hint" id={`${id}-size-note`}>
				{notes.size.map((text) => <span data-active={text === sizeNote(data, state) || undefined}>{text}</span>)}
			</p>
			<div class="segmented">
				{
					sizes.map((size) => (
						<label>
							<input
								type="radio"
								name={`${id}-size`}
								value={size}
								checked={size === state.size}
								disabled={!corpusOf(data, state.corpus).sizes.includes(size)}
							/>
							<span>{sizeLabel(size)}</span>
						</label>
					))
				}
			</div>
		</fieldset>
	</form>
	<div class="pareto-plot decoration not-content">
		<div class="pareto-static wide" set:html={chartSvg(data, state, WIDE_PX)} />
		<div class="pareto-static narrow" set:html={chartSvg(data, state, NARROW_PX)} />
		<div class="pareto-tip" id={`${id}-tip`} role="tooltip" hidden></div>
	</div>
	<form class="pareto-scale decoration not-content" aria-label="How the time axis is drawn" hidden>
		<fieldset>
			<legend>Time axis</legend>
			<div class="segmented">
				{
					SCALES.map((scale) => (
						<label>
							<input type="radio" name={`${id}-scale`} value={scale} checked={scale === state.scale} />
							<span>{SCALE_LABELS[scale]}</span>
						</label>
					))
				}
			</div>
		</fieldset>
	</form>
	<ul class="pareto-key decoration not-content" aria-hidden="true">
		<li><svg viewBox="-8 -8 16 16"><circle class="ekrina" r="5.5"></circle></svg>Ekrina</li>
		<li><svg viewBox="-9 -9 18 18"><path class="ekrina hollow" d="M0 -8L8 0L0 8L-8 0Z"></path></svg>Ekrina (acronym)</li>
		<li><svg viewBox="-8 -8 16 16"><rect class="ekrina hollow" x="-6" y="-6" width="12" height="12"></rect></svg>Ekrina (indexed)</li>
		<li><svg viewBox="-8 -8 16 16"><circle class="field" r="5.5"></circle></svg>Other libraries</li>
		<li class="key-front"><span class="front-swatch">On the frontier</span></li>
		<li class="key-line"><svg viewBox="0 -8 22 16"><line class="frontier" x1="1" y1="0" x2="21" y2="0"></line></svg>Pareto frontier</li>
	</ul>
	<figcaption aria-live="polite">
		{
			captionOf(data, state).map((sentence) => (
				<span class={sentence.tone}>{`${sentence.text} `}</span>
			))
		}
	</figcaption>
	<details class="pareto-numbers">
		<summary>The chart's numbers</summary>
		<div class="table-scroll" set:html={tableHtml(data, state)} />
	</details>
</figure>

<script>
	import { hydrate } from "../pareto-client.ts";

	for (const figure of document.querySelectorAll<HTMLElement>("figure.pareto")) {
		hydrate(figure);
	}
</script>

<style is:global>
	.pareto {
		container: pareto / inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-s);
		margin-block: var(--space-l);
	}

	.pareto-controls {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-s) var(--space-m);
	}

	@container pareto (width >= 39rem) {
		.pareto-controls {
			grid-template-columns: max-content minmax(0, 1fr);
		}

		/* The corpus spans under Size so its definition reads on one line; Size sits over its empty right half. */
		.pareto-controls .corpus-control {
			grid-area: 2 / 1 / 3 / -1;
		}

		.pareto-controls .size-control {
			grid-area: 2 / 2;
			align-self: start;
		}
	}

	.pareto-controls[hidden],
	.pareto-scale[hidden] {
		display: none;
	}

	.pareto-scale fieldset {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		border: 0;
	}

	.pareto-scale legend {
		float: left;
		padding: 0;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
	}

	.pareto-controls fieldset {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-content: start;
		align-items: baseline;
		column-gap: var(--space-2xs);
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	/* Floated, the legend leaves the fieldset's special legend slot and lays out as a grid item beside its hint. */
	.pareto-controls legend {
		float: left;
		padding: 0;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
	}

	.pareto-controls .segmented {
		grid-column: 1 / -1;
		width: fit-content;
		margin-block-start: var(--space-3xs);
	}

	.pareto-controls .segmented label {
		white-space: nowrap;
	}

	.pareto-controls .segmented:has(input:disabled),
	.pareto-controls .segmented:has(input:disabled) label + label {
		border-color: var(--line);
	}

	.pareto-controls .segmented label:has(input:disabled) {
		color: var(--ink-muted);
		cursor: not-allowed;
	}

	.pareto-controls :is(.control-hint, .corpus-definition) {
		display: grid;
		min-width: 0;
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
		line-height: var(--leading-snug);
	}

	.pareto-controls :is(.control-hint, .corpus-definition) > span {
		grid-area: 1 / 1;
		visibility: hidden;
	}

	.pareto-controls :is(.control-hint, .corpus-definition) > [data-active] {
		visibility: visible;
	}

	.pareto-controls .control-hint > span {
		padding-inline-start: var(--space-2xs);
		border-inline-start: 1px solid var(--line);
	}

	.pareto-controls .corpus-definition {
		grid-column: 1 / -1;
		margin-block-start: var(--space-2xs);
		text-wrap: pretty;
	}

	.pareto-plot {
		position: relative;
	}

	.pareto-static.narrow {
		display: none;
	}

	@container pareto (width < 33rem) {
		.pareto-static.wide {
			display: none;
		}

		.pareto-static.narrow {
			display: block;
		}
	}

	.pareto-svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
		-webkit-tap-highlight-color: transparent;
	}

	.pareto-svg .grid line {
		stroke: var(--line);
	}

	.pareto-svg .grid.minor line {
		stroke-opacity: 0.45;
	}

	.pareto-svg .axis line {
		stroke: var(--line-strong);
	}

	.pareto-svg .ticks text,
	.pareto-svg .title {
		fill: var(--ink-muted);
	}

	.pareto-svg .frontier,
	.pareto-key .frontier {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.5;
		stroke-linejoin: round;
		stroke-linecap: round;
		opacity: 0.55;
	}

	.pareto-svg .leader {
		stroke: var(--ink-muted);
		stroke-width: 1;
	}

	.pareto-svg .mark > *,
	.pareto-key .ekrina,
	.pareto-key .field {
		stroke: var(--paper);
		stroke-width: 1.5;
	}

	.pareto-svg .ekrina .mark > *,
	.pareto-key .ekrina {
		fill: var(--chart-ekrina);
	}

	.pareto-svg .field .mark > *,
	.pareto-key .field {
		fill: var(--chart-field);
	}

	.pareto-svg .mark > .hollow,
	.pareto-key .hollow {
		fill: none;
		stroke: var(--chart-ekrina);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.pareto-svg .ring > * {
		fill: none;
		stroke: var(--ink);
		stroke-width: 2;
		visibility: hidden;
	}

	.pareto-svg .pt {
		outline: none;
	}

	.pareto-svg .pt.is-active .ring > *,
	.pareto-svg .pt:focus-visible .ring > * {
		visibility: visible;
	}

	.pareto-svg .pt:focus-visible .ring > * {
		stroke: var(--sl-color-text-accent);
	}

	.pareto-svg .label {
		fill: var(--ink-muted);
		paint-order: stroke;
		stroke: var(--paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}

	.pareto-svg .label.front {
		fill: var(--highlight-ink);
		font-weight: 500;
		stroke: none;
	}

	.pareto-svg .label-mark {
		fill: var(--highlight);
	}

	.pareto-svg .label.is-active {
		fill: var(--ink);
		font-weight: 500;
		text-decoration: underline;
	}

	.pareto-svg .label.front.is-active {
		fill: var(--highlight-ink);
	}

	@media (prefers-reduced-motion: no-preference) {
		.pareto-plot.is-moving .pt {
			transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		.pareto-plot.is-moving :is(.labels, .leaders, .frontier) {
			animation: pareto-fade 260ms ease-out 140ms both;
		}
	}

	@keyframes pareto-fade {
		from {
			opacity: 0;
		}
	}

	.pareto-tip {
		position: absolute;
		z-index: 3;
		width: max-content;
		max-width: min(17rem, 100%);
		padding: var(--space-2xs) var(--space-xs);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		background: var(--paper);
		color: var(--ink);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
		line-height: var(--leading-snug);
		pointer-events: none;
	}

	.pareto-tip[hidden] {
		display: none;
	}

	/* On a phone the chart has no room to share, so the tooltip takes its place in the flow, above the key. */
	.pareto-tip.docked {
		position: static;
		width: auto;
		max-width: none;
		margin-block-start: var(--space-2xs);
	}

	.pareto-tip .tip-point + .tip-point {
		margin-block-start: var(--space-2xs);
		padding-block-start: var(--space-2xs);
		border-block-start: 1px solid var(--line-strong);
	}

	.pareto-tip p {
		margin: 0;
	}

	.pareto-tip .tip-name {
		font-weight: 500;
	}

	.pareto-tip dl {
		display: grid;
		grid-template-columns: auto auto;
		gap: 0 var(--space-s);
		margin: var(--space-3xs) 0;
	}

	.pareto-tip dl > div:not(.tip-group) {
		display: contents;
	}

	.pareto-tip dt {
		color: var(--ink-muted);
	}

	.pareto-tip dd {
		margin: 0;
		text-align: end;
	}

	.pareto-tip .tip-plotted :is(dt, dd) {
		color: var(--ink);
		font-weight: 500;
	}

	.pareto-tip .tip-group {
		grid-column: 1 / -1;
		margin-block-start: var(--space-3xs);
		padding-block-start: var(--space-3xs);
		border-block-start: 1px solid var(--line);
		color: var(--ink-muted);
	}

	.pareto-tip .tip-note {
		color: var(--ink-muted);
		text-wrap: pretty;
	}

	.pareto-key {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs) var(--space-m);
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
	}

	.pareto-key li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		margin: 0;
	}

	.pareto-key svg {
		width: 1rem;
		height: 1rem;
		overflow: visible;
	}

	.pareto-key svg:has(.frontier) {
		width: 1.375rem;
	}

	.pareto-key .front-swatch {
		padding: 0 var(--space-3xs);
		background: var(--highlight);
		color: var(--highlight-ink);
		font-weight: 500;
	}

	.pareto[data-frontier="none"] .key-front,
	.pareto:not([data-frontier="line"]) .key-line {
		display: none;
	}

	.pareto figcaption {
		max-width: 72ch;
		color: var(--ink-muted);
		font-size: var(--text-base);
		line-height: var(--leading-body);
		text-wrap: pretty;
	}

	.pareto figcaption :is(.lead, .warning) {
		color: var(--ink);
	}

	.pareto figcaption .warning {
		font-weight: 600;
	}

	.pareto-numbers summary {
		width: fit-content;
		min-height: var(--tap-target);
		padding-inline: var(--space-2xs);
		line-height: var(--tap-target);
		border-radius: var(--radius-control);
		color: var(--sl-color-text-accent);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
		cursor: pointer;
	}

	.pareto-numbers summary:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-ring-offset);
	}

	.pareto-numbers .table-scroll {
		margin-block-start: var(--space-xs);
	}

	/* The parts' headers are long beside their figures, so they wrap rather than widen the table. */
	.pareto .pareto-numbers table:has(th[style*="right"]) thead th {
		vertical-align: bottom;
		white-space: normal;
		text-wrap: balance;
	}
</style>
