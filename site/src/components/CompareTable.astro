---
import { bench, type CompareRow } from "../bench.ts";

type Column = {
	label: string;
	value: (row: CompareRow) => number;
	format: (value: number) => string;
	better: "higher" | "lower";
};

const columns: Column[] = [
	{ label: "MRR", value: (row) => row.mrr, format: (x) => x.toFixed(2), better: "higher" },
	{ label: "Junk", value: (row) => row.junk, format: (x) => `${Math.round(x * 100)}%`, better: "lower" },
	{ label: "ms/query", value: (row) => row.ms, format: (x) => x.toFixed(2), better: "lower" },
	{ label: "Gzip", value: (row) => row.gzipKB, format: (x) => `~${x} kB`, better: "lower" },
];

// Compared as printed, so two values that read the same are both marked.
const best = columns.map((column) => {
	const printed = bench.compareRows.map((row) => Number(column.format(column.value(row)).replace(/[^\d.]/g, "")));
	return column.better === "higher" ? Math.max(...printed) : Math.min(...printed);
});
const isBest = (k: number, row: CompareRow) =>
	Number(columns[k]!.format(columns[k]!.value(row)).replace(/[^\d.]/g, "")) === best[k];
---

<div class="compare table-scroll">
	<table>
		<thead>
			<tr>
				<th scope="col">Library</th>
				{columns.map((column) => <th scope="col">{column.label}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				bench.compareRows.map((row) => (
					<tr class:list={{ ekrina: row.isEkrina }}>
						<th scope="row">{row.name}</th>
						{columns.map((column, k) => {
							const wins = isBest(k, row);
							return (
								<td class:list={{ wins, ekrina: wins && row.isEkrina }}>
									{wins ? (
										<strong class="value">{column.format(column.value(row))}</strong>
									) : (
										column.format(column.value(row))
									)}
									{wins && <span class="sr-only">, best</span>}
								</td>
							);
						})}
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	/* Positioned so the screen-reader labels, which are absolute, scroll with the table instead of widening the page. */
	.compare {
		position: relative;
		margin-block: var(--space-m);
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--__sl-font-mono);
		font-size: var(--text-base);
		font-variant-numeric: tabular-nums;
	}

	th,
	td {
		padding: var(--space-2xs) var(--space-s) var(--space-2xs) 0;
		border-bottom: 1px solid var(--line);
		text-align: end;
		white-space: nowrap;
	}

	:is(th, td):first-child {
		text-align: start;
	}

	thead th {
		color: var(--ink-muted);
		font-size: var(--text-xs);
		font-weight: 400;
	}

	tbody th {
		font-weight: 400;
	}

	tr.ekrina th {
		font-weight: 600;
	}

	/* The column's best value, filled in the winner's series colour as the explorer's scoreline does. */
	.wins {
		--win: var(--chart-subject);
	}

	.wins.ekrina {
		--win: var(--chart-ekrina);
	}

	.wins .value {
		padding: 0.1em 0.4em;
		border-radius: 0.3em;
		background: color-mix(in oklab, var(--win) 24%, transparent);
		box-shadow: inset 0 -2px 0 var(--win);
		color: var(--ink);
		font-weight: 600;
	}

	@media (forced-colors: active) {
		.wins .value {
			outline: 1px solid CanvasText;
		}
	}

	@media (max-width: 30rem) {
		table {
			font-size: var(--text-xs);
		}

		th,
		td {
			padding-inline-end: var(--space-2xs);
		}

		tbody th {
			white-space: normal;
		}

		:is(th, td):last-child {
			padding-inline-end: 0;
		}

		.wins .value {
			padding-inline: 0.2em;
		}
	}
</style>
