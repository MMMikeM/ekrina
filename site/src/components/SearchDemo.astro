---
import corpus from "../../../bench/corpus-emoji.json";
import { emojiSearch } from "./emoji-search.ts";
import glyphs from "./emoji-glyphs.json";

if (glyphs.length !== corpus.length) {
	throw new Error(
		`emoji-glyphs.json has ${glyphs.length} glyphs for ${corpus.length} corpus items: run node scripts/emoji-glyphs.ts`,
	);
}

const examples = ["rainb", "partypop", "rcoket", "tears joy", "qxzwkv"];

// What three of them find, worked out by the same search at build time, for
// readers before they type and for the page's Markdown copy.
const search = emojiSearch(corpus, glyphs);
const samples = ["rcoket", "tears joy", "qxzwkv"].map((query) => {
	const [top] = search(query);
	const corrected = top?.tier === "corrected";
	return { query, found: top && `${top.item.glyph} ${top.item.label}`, corrected };
});
---

<div class="search-demo not-content" data-search-demo>
	<label class="field decoration">
		<span class="field-label">Search {corpus.length.toLocaleString("en")} emoji by name or tag, in your browser</span>
		<input
			type="search"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			enterkeyhint="search"
			placeholder="Try a typo"
		/>
	</label>
	<div class="examples decoration" role="group" aria-label="Example queries">
		<span class="examples-label" aria-hidden="true">Try</span>
		{examples.map((query) => <button type="button" data-query={query}>{query}</button>)}
	</div>
	<p class="sample">
		For example,{" "}
		{samples.map(({ query, found, corrected }, i) => (
			<>
				{i === samples.length - 1 && "and "}<code>{query}</code>{" "}
				{found ? `finds ${found}${corrected ? ", as a correction" : ""}` : "finds nothing"}
				{i < samples.length - 1 ? "; " : "."}
			</>
		))}
	</p>
	<div class="panel decoration">
		<div aria-live="polite">
			<p class="status"></p>
			<p class="corrected" hidden>Showing results for <strong></strong></p>
		</div>
		<ol class="results"></ol>
	</div>
</div>

<script>
	import type { HighlightRange, SearchResult } from "../../../src/index.ts";
	import { DEMO_LIMIT as LIMIT, type Emoji, type EmojiSearch as Searcher } from "./emoji-search.ts";

	const TAG_SEPARATOR = ", ";

	let searcher: Promise<Searcher> | undefined;

	const loadSearcher = (): Promise<Searcher> =>
		(searcher ??= Promise.all([
			import("./emoji-search.ts"),
			import("../../../bench/corpus-emoji.json"),
			import("./emoji-glyphs.json"),
		]).then(([{ emojiSearch }, { default: corpus }, { default: glyphs }]) => emojiSearch(corpus, glyphs)).catch((error: unknown) => {
			searcher = undefined;
			throw error;
		}));

	const warmUp = (): void => {
		loadSearcher().catch(() => {});
	};

	// Ranges are inclusive at both ends; only the part inside [from, to) is drawn.
	const appendHighlighted = (
		parent: HTMLElement,
		text: string,
		ranges: HighlightRange[],
		from = 0,
		to = text.length,
	): void => {
		let at = from;
		for (const [start, end] of ranges) {
			const markStart = Math.max(start, at);
			const markEnd = Math.min(end + 1, to);
			if (markEnd <= markStart) continue;
			if (markStart > at) parent.append(text.slice(at, markStart));
			const mark = document.createElement("mark");
			mark.textContent = text.slice(markStart, markEnd);
			parent.append(mark);
			at = markEnd;
		}
		if (at < to) parent.append(text.slice(at, to));
	};

	const matchedTags = (tags: string, ranges: HighlightRange[]): HTMLElement => {
		const line = document.createElement("span");
		line.className = "tags";
		let start = 0;
		for (const tag of tags.split(TAG_SEPARATOR)) {
			const end = start + tag.length;
			if (ranges.some(([from, to]) => from < end && to >= start)) {
				if (line.childNodes.length) line.append(TAG_SEPARATOR);
				appendHighlighted(line, tags, ranges, start, end);
			}
			start = end + TAG_SEPARATOR.length;
		}
		return line;
	};

	const row = (result: SearchResult<Emoji, "label" | "tags">): HTMLLIElement => {
		const { glyph, label, tags } = result.item;
		const labelMatched = result.field === "label";
		const item = document.createElement("li");

		const emoji = document.createElement("span");
		emoji.className = "glyph";
		emoji.setAttribute("aria-hidden", "true");
		emoji.textContent = glyph;

		const text = document.createElement("span");
		text.className = "text";
		const name = document.createElement("span");
		name.className = "label";
		appendHighlighted(name, label, labelMatched ? result.ranges : []);
		text.append(name);
		if (!labelMatched && tags) text.append(matchedTags(tags, result.ranges));

		const tier = document.createElement("span");
		tier.className = "tier";
		tier.dataset.tier = result.tier;
		tier.textContent = result.tier;

		item.append(emoji, text, tier);
		return item;
	};

	const countText = (query: string, count: number): string => {
		if (count === 0) return `No emoji is close enough to “${query}” to guess.`;
		if (count === LIMIT) return `Best ${LIMIT} matches`;
		return count === 1 ? "1 match" : `${count} matches`;
	};

	const setUp = (root: HTMLElement): void => {
		const input = root.querySelector("input")!;
		const status = root.querySelector<HTMLElement>(".status")!;
		const corrected = root.querySelector<HTMLElement>(".corrected")!;
		const correctedQuery = corrected.querySelector("strong")!;
		const list = root.querySelector<HTMLOListElement>(".results")!;

		const render = (query: string, results: SearchResult<Emoji, "label" | "tags">[]): void => {
			const top = results[0];
			const correction = top?.tier === "corrected" ? top.corrected : undefined;
			corrected.hidden = !correction;
			correctedQuery.textContent = correction ?? "";
			list.replaceChildren(...results.map(row));
			root.toggleAttribute("data-empty", query !== "" && results.length === 0);
			status.textContent = query === "" ? "" : countText(query, results.length);
		};

		const update = async (): Promise<void> => {
			const query = input.value.trim();
			if (query === "") return render("", []);
			// On a phone the results start near the bottom of the screen, where the
			// keyboard covers them, so the first keystroke brings the field to the top.
			if (!root.hasAttribute("data-used") && list.getBoundingClientRect().top > innerHeight * 0.6) {
				root.querySelector(".field")!.scrollIntoView({ block: "start" });
			}
			root.setAttribute("data-used", "");
			// Overwritten before paint once the emoji have loaded, since a settled promise resumes in a microtask.
			status.textContent = "Loading the emoji…";
			let search: Searcher;
			try {
				search = await loadSearcher();
			} catch {
				status.textContent = "The emoji didn’t load. Type again to retry.";
				return;
			}
			if (input.value.trim() === query) render(query, search(query));
		};

		root.addEventListener("focusin", warmUp, { once: true });
		root.addEventListener("pointerenter", warmUp, { once: true });
		input.addEventListener("input", update);
		for (const button of root.querySelectorAll<HTMLButtonElement>("[data-query]")) {
			button.addEventListener("click", () => {
				input.value = button.dataset.query!;
				input.dispatchEvent(new Event("input"));
			});
		}
	};

	for (const root of document.querySelectorAll<HTMLElement>("[data-search-demo]")) setUp(root);
</script>

<style>
	.search-demo {
		display: grid;
		gap: var(--space-xs);
		max-width: 40rem;
	}

	.field {
		scroll-margin-top: calc(var(--sl-nav-height) + var(--space-s));
		display: grid;
		gap: var(--space-2xs);
	}

	.field-label {
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
	}

	input {
		width: 100%;
		min-height: var(--tap-target);
		padding: var(--space-2xs) var(--space-xs);
		border: 1px solid var(--line-strong);
		border-bottom: 2px solid var(--chart-ekrina);
		border-radius: var(--radius-control) var(--radius-control) 0 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xl);
	}

	input::placeholder {
		color: var(--ink-muted);
		opacity: 1;
	}

	input:focus-visible,
	button:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-ring-offset);
	}

	.examples {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2xs);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
	}

	.examples-label {
		color: var(--ink-muted);
	}

	button {
		min-height: 2.25rem;
		padding: 0 var(--space-xs);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		background: none;
		color: var(--ink);
		font: inherit;
		cursor: pointer;
	}

	button:hover {
		background: color-mix(in srgb, var(--ink) 8%, transparent);
	}

	.sample {
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--text-sm);
	}

	[data-used] .sample {
		display: none;
	}

	/* Once in use, a full list's height whatever the result count, so the page below doesn't jump as you type. */
	[data-used] .panel {
		min-height: calc(var(--space-l) + 8 * var(--tap-target));
	}

	.status {
		min-height: 1lh;
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
	}

	[data-empty] .status {
		color: var(--ink);
	}

	.corrected {
		margin: var(--space-3xs) 0 0;
		color: var(--ink-muted);
		font-size: var(--text-base);
	}

	.corrected strong {
		color: var(--ink);
		font-family: var(--__sl-font-mono);
		font-weight: 500;
	}

	.results {
		margin: var(--space-2xs) 0 0;
		padding: 0;
		list-style: none;
	}

	/* The script builds the rows, and scoped styles only reach what the template renders. */
	.results :global(li) {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-xs);
		min-height: var(--tap-target);
		padding-block: var(--space-3xs);
		border-bottom: 1px solid var(--line);
	}

	.results :global(li:first-child) {
		border-top: 1px solid var(--line);
	}

	.results :global(.glyph) {
		font-size: var(--text-2xl);
		line-height: 1;
		text-align: center;
	}

	.results :global(.text) {
		display: grid;
		min-width: 0;
	}

	.results :global(.label) {
		color: var(--ink);
		font-size: var(--text-base);
		line-height: var(--leading-snug);
		overflow-wrap: anywhere;
	}

	.results :global(.tags) {
		overflow: hidden;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.results :global(mark) {
		padding-inline: 0;
	}

	.results :global(.tier) {
		padding: 0.0625rem var(--space-2xs);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-control);
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-xs);
		white-space: nowrap;
	}

	/* A guess about what was meant, not text that appears in the name. */
	.results :global(.tier:is([data-tier="fuzzy"], [data-tier="corrected"])) {
		border-style: dashed;
	}
</style>
