{
	"name": "ekrina",
	"version": "2.0.0",
	"description": "Fuzzy search that corrects up to two typos per query, says how every result matched, and returns nothing for nonsense. Zero dependencies.",
	"keywords": [
		"autocomplete",
		"filter",
		"fuse-alternative",
		"fuzzy-match",
		"fuzzy-search",
		"match-sorter",
		"microfuzz",
		"search",
		"typescript"
	],
	"homepage": "https://github.com/MMMikeM/ekrina#readme",
	"bugs": {
		"url": "https://github.com/MMMikeM/ekrina/issues"
	},
	"license": "MIT",
	"author": "Mike <contactme@mikem.mozmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MMMikeM/ekrina.git"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"prepare": "vp config --no-agent"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@vitest/coverage-v8": "5.0.5",
		"@voidzero-dev/vite-plus-core": "^1.4.0",
		"fast-check": "4.10.2",
		"knip": "^6.44.1",
		"publint": "^0.3.22",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@12.16.1"
}
